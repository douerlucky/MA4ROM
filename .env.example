# Copy to .env, replace placeholders, and load it in your shell.
# Never commit the resulting .env file.
LLM_API_KEY=replace-with-your-own-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_MAX_API_ATTEMPTS=250
LLM_MAX_TOTAL_TOKENS=1500000
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_SECONDS=45
LLM_HARD_TIMEOUT_SECONDS=55

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
PGDATABASE=postgres

