    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"locatedOnIsland\" , \"type\" , \"lastEruption\" , \"inMountains\" , \"name\" , \"elevation\" , \"longitude\" , \"latitude\" , \"rdftype\" FROM \"Mountain\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/mountain/{URI}" ; rr:class mondialrel:Mountain ] ;
