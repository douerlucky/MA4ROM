    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"hasMother\" , \"hasFather\" FROM \"Male\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/male/{URI}" ; rr:class mondialrel:Lake ] ;
    rr:predicateObjectMap [
        rr:predicate <http://www.semwebtech.org/mondial/10/meta#hasEstuary-> ;
        rr:objectMap [ rr:template "http://example.com/male/{hasFather}" ]
    ] .

