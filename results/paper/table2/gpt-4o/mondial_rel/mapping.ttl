@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix mondialrel: <http://www.semwebtech.org/mondial/10/meta#> .
@base <http://example.com/> .

# === hasChild (SR) ===
# SKIP: hasChild (SR) 无 ObjectProperty

# === locatedAt (SR) ===
<#locatedAtMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"City\" , \"Water\" FROM \"locatedAt\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/city/{City}" ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:locatedAt ;
        rr:objectMap [ rr:template "http://example.com/water/{Water}" ]
    ] .

# === locatedInWater (SR) ===
<#locatedInWaterMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"Island\" , \"Water\" FROM \"locatedInWater\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/island/{Island}" ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:locatedInWater ;
        rr:objectMap [ rr:template "http://example.com/water/{Water}" ]
    ] .

# === locatedOnIsland (SR) ===
<#locatedOnIslandMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"Entity\" , \"Island\" FROM \"locatedOnIsland\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/city/{Entity}" ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:locatedOnIsland ;
        rr:objectMap [ rr:template "http://example.com/island/{Island}" ]
    ] .

# === marriedWith (SR) ===
# SKIP: marriedWith (SR) 无 ObjectProperty

# === mergesWith (SR) ===
<#mergesWithMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"Sea1\" , \"Sea2\" FROM \"mergesWith\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/water/{Sea1}" ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:mergesWith ;
        rr:objectMap [ rr:template "http://example.com/water/{Sea2}" ]
    ] .

# === BelievedBy (SE) ===
<#BelievedByMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"percent\" , \"religionInfo-\" , \"onReligion\" FROM \"BelievedBy\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/believedby/{URI}" ; rr:class mondialrel:BelievedBy ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:percent ;
        rr:objectMap [ rr:column "percent" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:religionInfo ;
        rr:objectMap [ rr:template "http://example.com/country/{religionInfo-}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:onReligion ;
        rr:objectMap [ rr:template "http://example.com/religion/{onReligion}" ]
    ] .

# === Border (SE) ===
<#BorderMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"length\" , \"Country1\" , \"Country2\" FROM \"Border\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/border/{URI}" ; rr:class mondialrel:Border ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:length ;
        rr:objectMap [ rr:column "length" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:bordering ;
        rr:objectMap [ rr:template "http://example.com/country/{Country1}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:bordering ;
        rr:objectMap [ rr:template "http://example.com/country/{Country2}" ]
    ] .

# === City (SE) ===
<#CityMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"name\" , \"population\" , \"elevation\" , \"longitude\" , \"latitude\" FROM \"City\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/city/{URI}" ; rr:class mondialrel:City ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:name ;
        rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:population ;
        rr:objectMap [ rr:column "population" ; rr:datatype xsd:nonNegativeInteger ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:elevation ;
        rr:objectMap [ rr:column "elevation" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:longitude ;
        rr:objectMap [ rr:column "longitude" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:latitude ;
        rr:objectMap [ rr:column "latitude" ; rr:datatype xsd:decimal ]
    ] .

# === Continent (SE) ===
<#ContinentMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"name\" , \"area\" FROM \"Continent\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/continent/{URI}" ; rr:class mondialrel:Continent ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:name ;
        rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:area ;
        rr:objectMap [ rr:column "area" ; rr:datatype xsd:decimal ]
    ] .

# === Country (SE) ===
<#CountryMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"gdpAgri\" , \"inflation\" , \"populationGrowth\" , \"government\" , \"gdpServ\" , \"population\" , \"gdpTotal\" , \"unemployment\" , \"independenceDate\" , \"dependentOf\" , \"infantMortality\" , \"area\" , \"gdpInd\" , \"carCode\" , \"capital\" , \"wasDependentOf\" , \"name\" FROM \"Country\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/country/{URI}" ; rr:class mondialrel:Country ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:gdpAgri ;
        rr:objectMap [ rr:column "gdpAgri" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:inflation ;
        rr:objectMap [ rr:column "inflation" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:populationGrowth ;
        rr:objectMap [ rr:column "populationGrowth" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:government ;
        rr:objectMap [ rr:column "government" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:gdpServ ;
        rr:objectMap [ rr:column "gdpServ" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:population ;
        rr:objectMap [ rr:column "population" ; rr:datatype xsd:nonNegativeInteger ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:gdpTotal ;
        rr:objectMap [ rr:column "gdpTotal" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:unemployment ;
        rr:objectMap [ rr:column "unemployment" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:independenceDate ;
        rr:objectMap [ rr:column "independenceDate" ; rr:datatype xsd:date ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:dependentOf ;
        rr:objectMap [ rr:template "http://example.com/country/{dependentOf}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:infantMortality ;
        rr:objectMap [ rr:column "infantMortality" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:area ;
        rr:objectMap [ rr:column "area" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:gdpInd ;
        rr:objectMap [ rr:column "gdpInd" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:carCode ;
        rr:objectMap [ rr:column "carCode" ; rr:datatype xsd:string ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:capital ;
        rr:objectMap [ rr:template "http://example.com/city/{capital}" ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:name ;
        rr:objectMap [ rr:column "name" ; rr:datatype xsd:string ]
    ] .

# === Desert (SE) ===
<#DesertMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"area\" , \"type\" , \"latitude\" , \"longitude\" , \"name\" FROM \"Desert\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/desert/{URI}" ; rr:class mondialrel:Desert ] ;
