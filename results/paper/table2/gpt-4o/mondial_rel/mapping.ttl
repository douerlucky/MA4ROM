# === Female (SE) ===
<#FemaleMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"onlyfemaleprop\" , \"hasMother\" , \"hasFather\" FROM \"Female\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/female/{URI}" ; rr:class xsd:decimal ] ;
    rr:predicateObjectMap [
        rr:predicate <http://www.semwebtech.org/mondial/10/meta#hasEstuary-> ;
        rr:objectMap [ rr:template "http://example.com/male/{hasFather}" ]
    ] .

# === Island (SE) ===
<#IslandMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"population\" , \"latitude\" , \"belongsToIslands\" , \"area\" , \"name\" , \"longitude\" , \"type\" , \"elevation\" FROM \"Island\"" ] ;
