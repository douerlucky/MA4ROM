    ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:latitude ;
        rr:objectMap [ rr:column "latitude" ; rr:datatype xsd:decimal ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate <http://www.semwebtech.org/mondial/10/meta#hasEstuary-> ;
        rr:objectMap [ rr:template "http://example.com/water/{hasEstuary-}" ]
    ] .

