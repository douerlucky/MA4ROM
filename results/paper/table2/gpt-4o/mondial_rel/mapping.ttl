# === Estuary (SE) ===
<#EstuaryMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"longitude\" , \"elevation\" , \"latitude\" , \"hasEstuary-\" FROM \"Estuary\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/estuary/{URI}" ; rr:class mondialrel:Estuary ] ;
    rr:predicateObjectMap [
        rr:predicate mondialrel:longitude ;
