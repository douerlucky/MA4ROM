# === Source (SE) ===
<#SourceMapping> a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"URI\" , \"inMountains\" , \"longitude\" , \"elevation\" , \"hasSource-\" , \"latitude\" FROM \"Source\"" ] ;
    rr:subjectMap [ rr:template "http://example.com/source/{URI}" ; rr:class mondialrel:Source ] ;
